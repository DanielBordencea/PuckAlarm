<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Requires a paid Apple Developer Program membership. A free Apple ID cannot sign a
	  build carrying this entitlement; remove this file from the target's
	  CODE_SIGN_ENTITLEMENTS setting to build with a free account, and use the
	  "Simulate puck scans" switch in Settings instead of real NFC.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>NDEF</string>
	</array>
</dict>
</plist>
